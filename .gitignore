.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

instance/
uploads/
*.db
*.sqlite3

# Test artifacts - hundreds of MB of disk images and memory dumps. Kept out of
# the repo deliberately; document where to obtain them instead.
sample/

# Source datasets: the CIC-MalMem-2022 CSV and the EMBER 2018 tarball. Gigabytes,
# publicly obtainable, and not ours to redistribute. The held-out rows derived
# from them under data/holdout/ ARE committed - they are a few KB and the demos
# depend on them.
data/*
!data/holdout/

# Volatility 3 ISF symbol cache - large, and machine/build specific.
# Pre-populate it per deployment; see CLAUDE.md 5.5.
symbols/

.vscode/
.idea/
*.log

# models/ and reference_data/ are deliberately NOT ignored.
# reference_data/*.npy is the only surviving copy of the training
# distributions (CLAUDE.md 8.1) - losing it is unrecoverable.